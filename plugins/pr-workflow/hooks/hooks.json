{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(gh *)", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-guard.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-reset.sh" }
        ]
      }
    ]
  }
}
